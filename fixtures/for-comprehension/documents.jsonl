{"path":"src/forcase/Pipeline.scala","revision":"ac8dc2e3c31974a05859c3a5ebb571932c494230","semanticdb_input":"raw/META-INF/semanticdb/src/forcase/Pipeline.scala.semanticdb","semanticdb_input_sha256":"2111ba3be3f820e09aeb0deceacafd46881294966c4085a2365aa23ff82d8bdb","capture_producer_sha256":"5765acb0c4ef1d4204a2fbfa96f063cb32e3f1c45bd12089e2fca8caee5e74f4","source_sha256":"4374b9080235e1b979127108cd1a4d872e49e98479c87e88ade73979b3d9313a","source_md5":"8e99900b29edf46cfb8ab7c1f59d14e6","source_md5_matches":true,"source_contexts":["project:for-comprehension/configuration:test"],"input_target_contexts":["project:for-comprehension/configuration:test"],"source_text":"package forcase\n\nimport scala.concurrent.{ExecutionContext, Future}\nimport org.scalatest.Suite\n\nobject Effects {\n  var events: Vector[String] = Vector.empty\n  def note(value: String): Unit = { events = events :+ value }\n}\n\ntrait Pipeline {\n  implicit val context: ExecutionContext = ExecutionContext.parasitic\n\n  def first(): Future[Int] = { Effects.note(\"first\"); Future.successful(3) }\n  def load(value: Int): Future[Int] = { Effects.note(s\"load:$value\"); Future.successful(value) }\n  def check(value: Int): Unit = Effects.note(s\"check:$value\")\n  def save(value: Int): Future[Unit] = { Effects.note(s\"save:$value\"); Future.successful(()) }\n  def after(value: Int): Future[Unit] = { Effects.note(s\"after:$value\"); Future.successful(()) }\n  def finish(): Future[Unit] = { Effects.note(\"finish\"); Future.successful(()) }\n  def clueF[A](label: String)(body: => Future[A]): Future[A] = {\n    Effects.note(s\"clue:$label\")\n    body\n  }\n\n  def execute(): Future[Unit] = for {\n    seed <- first()\n    _ <- clueF(\"guard\")(for {\n      item <- load(seed)\n      _ = check(item)\n      _ <- save(item)\n      _ <- after(item)\n    } yield ())\n    _ <- finish()\n  } yield ()\n\n  def dormant(): Future[Unit] = clueF(\"dormant\")(for {\n    item <- load(99)\n    _ = check(item)\n    _ <- save(item)\n    _ <- after(item)\n  } yield ())\n}\n\nclass ActiveSuite extends Suite with Pipeline {\n  val completed: Future[Unit] = execute()\n}\n\nclass DormantSuite extends Suite with Pipeline {\n  val stored: () => Future[Unit] = () => dormant()\n}\n","enclosing_member_attribution":"Definition ranges cover name tokens; join validated source AST spans separately.","document":{"schema":4,"uri":"src/forcase/Pipeline.scala","symbols":[{"symbol":"forcase/ActiveSuite#","kind":13,"display_name":"ActiveSuite","language":1,"signature":{"class_signature":{"type_parameters":{},"parents":[{"type_ref":{"symbol":"scala/AnyRef#"}},{"type_ref":{"symbol":"org/scalatest/Suite#"}},{"type_ref":{"symbol":"forcase/Pipeline#"}}],"declarations":{"symlinks":["forcase/ActiveSuite#`<init>`().","forcase/ActiveSuite#completed."]}}},"access":{"public_access":null}},{"symbol":"forcase/ActiveSuite#`<init>`().","kind":21,"properties":8192,"display_name":"<init>","language":1,"signature":{"method_signature":{"type_parameters":{},"parameter_lists":[{}]}},"access":{"public_access":null}},{"symbol":"forcase/ActiveSuite#completed.","kind":3,"properties":1024,"display_name":"completed","language":1,"signature":{"method_signature":{"type_parameters":{},"return_type":{"type_ref":{"symbol":"scala/concurrent/Future#","type_arguments":[{"type_ref":{"symbol":"scala/Unit#"}}]}}}},"access":{"public_access":null}},{"symbol":"forcase/DormantSuite#","kind":13,"display_name":"DormantSuite","language":1,"signature":{"class_signature":{"type_parameters":{},"parents":[{"type_ref":{"symbol":"scala/AnyRef#"}},{"type_ref":{"symbol":"org/scalatest/Suite#"}},{"type_ref":{"symbol":"forcase/Pipeline#"}}],"declarations":{"symlinks":["forcase/DormantSuite#`<init>`().","forcase/DormantSuite#stored."]}}},"access":{"public_access":null}},{"symbol":"forcase/DormantSuite#`<init>`().","kind":21,"properties":8192,"display_name":"<init>","language":1,"signature":{"method_signature":{"type_parameters":{},"parameter_lists":[{}]}},"access"