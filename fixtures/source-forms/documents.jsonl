older(1) == 1 && Forms.observed == 22)\n    assert(Forms.eta(2) == 2 && Forms.observed == 32)\n    assert(Forms.namedCall == 12)\n    assert(Forms.yielding == List(7) && Forms.observed == 43)\n    assert(Forms.interpolate == \"value=7\" && Forms.observed == 44)\n    val capturedReceiver = Forms.receiverEta\n    assert(Forms.observed == 1044, \"eta receiver must be evaluated at callback creation\")\n    assert(capturedReceiver(3) == 3 && Forms.observed == 1054)\n    assert(Forms.curriedEta(1)(2) == 2)\n    assert(Forms.bareEta(4) == 4 && Forms.observed == 1154)\n    val bareReceiver = Forms.bareReceiverEta\n    assert(Forms.observed == 2154, \"bare eta receiver must be evaluated at callback creation\")\n    assert(bareReceiver(5) == 5 && Forms.observed == 2254)\n    assert(Forms.nullaryBare == 7 && Forms.observed == 2255)\n    println(\"source-forms:typed=7:applied=7:placeholder=1:eta=2:named=12:yield=7:receiver=3:bare=4:bare-receiver=5:nullary=7:calls=2255\")\n  }\n}\n","enclosing_member_attribution":"Definition ranges cover name tokens; join validated source AST spans separately.","document":{"schema":4,"uri":"src/sourceforms/Forms.scala","symbols":[{"symbol":"local0","kind":19,"properties":1024,"display_name":"eta$0$1","language":1,"signature":{"value_signature":{"tpe":{"single_type":{"symbol":"sourceforms/Forms."}}}}},{"symbol":"local1","kind":19,"properties":1024,"display_name":"eta$0$1","language":1,"signature":{"value_signature":{"tpe":{"single_type":{"symbol":"sourceforms/Forms."}}}}},{"symbol":"local2","kind":8,"display_name":"x","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local3","kind":19,"properties":1024,"display_name":"x$1","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local4","kind":19,"properties":1024,"display_name":"x$2","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local5","kind":1