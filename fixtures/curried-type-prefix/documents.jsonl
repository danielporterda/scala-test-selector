{"path":"apps/common/src/test/scala/org/lfdecentralizedtrust/splice/config/ThresholdsTest.scala","revision":"8d6193f4c449e04e7d96840d13f031cf966fe146","semanticdb_input":"apps/common/target/scala-2.13/test-meta/META-INF/semanticdb/apps/common/src/test/scala/org/lfdecentralizedtrust/splice/config/ThresholdsTest.scala.semanticdb","semanticdb_input_sha256":"96ad583a85053249f3af61f9d6fed4c0428546053c0399e1e85ee1677eacce01","source_sha256":"7f00df896db27bba5e35ac7993c0b2f98d228fe48430308fabec0a69d80a35b7","source_md5":"82e121f6734b7668edb9408149433294","source_md5_matches":true,"source_contexts":["project:apps-common/configuration:test"],"input_target_contexts":["project:apps-common/configuration:test"],"source_text":"package org.lfdecentralizedtrust.splice.config\n\nimport com.digitalasset.canton.BaseTest\nimport com.digitalasset.canton.config.RequireTypes.PositiveInt\nimport com.digitalasset.canton.topology.ParticipantId\nimport com.digitalasset.canton.topology.transaction.{HostingParticipant, ParticipantPermission}\nimport org.scalatest.wordspec.AnyWordSpecLike\n\nclass ThresholdsTest extends AnyWordSpecLike with BaseTest {\n\n  \"thresholds\" should {\n    \"return expected DSO thresholds\" in {\n      forAll(Table((\"SVs\", \"threshold\"), (1, 1), (2, 2), (3, 2), (4, 3))) {\n        (svs: Int, threshold: Int) =>\n          Thresholds.decentralizedNamespaceThreshold(svs) shouldBe PositiveInt\n            .tryCreate(\n              threshold\n            )\n      }\n    }\n\n    \"return expected f based DSO thresholds\" in {\n      forAll(Table((\"SVs\", \"threshold\"), (1, 1), (2, 1), (3, 1), (4, 2))) {\n        (svs: Int, threshold: Int) =>\n          Thresholds.sequencerConnectionsSizeThreshold(svs) shouldBe PositiveInt\n            .tryCreate(\n              threshold\n            )\n      }\n    }\n\n    \"return expected f based minimum DSO thresholds\" in {\n      forAll(\n        Table(\n          (\"mapping specific size\", \"threshold\"),\n          (1, 1),\n          (2, 1),\n          (3, 1),\n          (4, 2),\n        )\n      ) { (mappingSpecificSize: Int, threshold: Int) =>\n        Thresholds.mediatorDomainStateThreshold(\n          mappingSpecificSize\n        ) shouldBe PositiveInt\n          .tryCreate(threshold)\n      }\n      forAll(\n        Table(\n          (\"mapping specific size\", \"threshold\"),\n          (1, 1),\n          (2, 2),\n          (3, 2),\n          (4, 3),\n          (5, 4),\n          (6, 4),\n          (7, 5),\n        )\n      ) { (mappingSpecificSize: Int, threshold: Int) =>\n        Thresholds.partyToParticipantThreshold(\n          mkHostingParticipantsOfSize(mappingSpecificSize)\n        ) shouldBe PositiveInt\n          .tryCreate(threshold)\n      }\n    }\n  }\n\n  private def mkHostingParticipantsOfSize(size: Int): Seq[HostingParticipant] = {\n    (1 to size).map(i =>\n      HostingParticipant(\n        ParticipantId.tryFromProtoPrimitive(s\"PAR::participant$i::dummy\"),\n        ParticipantPermission.Submission,\n      )\n    )\n  }\n}\n","enclosing_member_attribution":"Definition ranges cover name tokens; join validated source AST spans separately.","document":{"schema":4,"uri":"apps/common/src/test/scala/org/lfdecentralizedtrust/splice/config/ThresholdsTest.scala","symbols":[{"symbol":"local0","kind":8,"display_name":"svs","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local1","kind":8,"display_name":"threshold","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local2","kind":8,"display_name":"svs","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local3","kind":8,"display_name":"threshold","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol":"scala/Int#"}}}}},{"symbol":"local4","kind":8,"display_name":"mappingSpecificSize","language":1,"signature":{"value_signature":{"tpe":{"type_ref":{"symbol